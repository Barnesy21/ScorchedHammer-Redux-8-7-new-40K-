          <selectionEntries>
            <selectionEntry type="upgrade" import="true" name="Ritual Knife" hidden="false" id="172b-9aba-43a7-1e41">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="df97-9305-e30c-de76" includeChildSelections="false"/>
              </constraints>
              <profiles>
                <profile name="Ritual Knife" typeId="10e3-235b-fd89-87a6" typeName="Abillities" hidden="false" id="a57a-c9d0-b7aa-ffaf">
                  <characteristics>
                    <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">If this model has a ritual knife, after making a consolidate move, select one enemy unit within 1&quot; of this model and roll one D6; on a 2-5 that unit suffers 1 mortal wound, on a 6 that unit suffers D3 mortal wounds.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Living Whip" hidden="false" id="6b42-ade2-e571-25a5">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="a2a0-ad7f-3bf6-01b0" includeChildSelections="false"/>
