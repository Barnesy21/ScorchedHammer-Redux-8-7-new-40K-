      </infoLinks>
      <entryLinks>
        <entryLink import="true" name="Discipline of Slaanesh" hidden="false" id="3875-3044-f1e6-5313" type="selectionEntry" targetId="f8fa-5c91-c160-1a2e">
          <constraints>
            <constraint type="max" value="2" field="selections" scope="self" shared="true" id="63b4-9133-d3c7-7050" includeChildSelections="false"/>
          </constraints>
        </entryLink>
      </entryLinks>
      <profiles>
        <profile name="Gift of Power" typeId="10e3-235b-fd89-87a6" typeName="Abillities" hidden="false" id="e441-15bb-580b-f2e1">
          <characteristics>
            <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">When a Psychic test or Deny the Witch test is taken for this model, add 1 to the total.</characteristic>
          </characteristics>
        </profile>
        <profile name="Horrible Fascination" typeId="10e3-235b-fd89-87a6" typeName="Abillities" hidden="false" id="199d-94d8-b82b-bbc1">
          <characteristics>
            <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">When a unit within 6&quot; of any enemy models with this ability is chosen to Fall Back, roll 3D6; if the total is greater than or equal to that unit’s Leadership characteristic, that unit cannot Fall Back this turn.</characteristic>
          </characteristics>
        </profile>
        <profile name="Swallow Energy" typeId="10e3-235b-fd89-87a6" typeName="Abillities" hidden="false" id="8e57-8477-108a-1050">
          <characteristics>
            <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">When this model would lose a wound as a result of a mortal wound, roll one D6; on a 2+ that wound is not lost.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <categoryLinks>
        <categoryLink targetId="3275-df5e-2474-90ed" id="c455-07e9-90d9-d65d" primary="false" name="Character"/>
