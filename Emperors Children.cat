    <profile name="Excessive Assault" typeId="10e3-235b-fd89-87a6" typeName="Abillities" hidden="false" id="650c-57d5-d277-b132">
      <characteristics>
        <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">Each time a model in this unit targets an enemy unit with a melee attack, re-roll a Wound roll of 1. If that enemy unit is within range of an objective marker, you can re-roll the Wound roll instead.</characteristic>
      </characteristics>
    </profile>
    <profile name="Icon of Excess" typeId="10e3-235b-fd89-87a6" typeName="Abillities" hidden="false" id="47e0-6235-5901-c871">
      <characteristics>
        <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">A unit with a Icon of Excess has the Lance Charge Special Rule on all there melee weapons, and may Fire one type of weapon twice at the same target if it was not destroyed, if you Split file you cannot shoot twice.</characteristic>
      </characteristics>
    </profile>
