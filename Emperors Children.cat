        <profile name="Master of Combat" typeId="10e3-235b-fd89-87a6" typeName="Abillities" hidden="false" id="80de-dfe9-c76d-fb94">
          <characteristics>
            <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">IF this model is equipped with 2 Close combat weapon, This model must attack with one weapon for the number of attacks on the data sheet and makes 3 Bonus attacks with the other weapon on their profile.</characteristic>
          </characteristics>
        </profile>
      </profiles>
