    <profile name="Locus of Slaanesh" typeId="10e3-235b-fd89-87a6" typeName="Abillities" hidden="false" id="7c65-438e-3f1c-02f0">
      <characteristics>
        <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">Add 1 to the Strength characteristic of models in SLAANESH DAEMON units whilst their unit is within 6&quot; of any friendly models with this ability.</characteristic>
      </characteristics>
    </profile>
    <profile name="Scything Impact" typeId="10e3-235b-fd89-87a6" typeName="Abillities" hidden="false" id="324a-b788-695d-f3f3">
      <characteristics>
        <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">After this unit finishes a charge move, roll one D6 for each enemy model that is within 1&quot; of this model; for each roll of 6, that model’s unit suffers 1 mortal wound.</characteristic>
      </characteristics>
    </profile>
