                </selectionEntry>
                <selectionEntry type="upgrade" import="true" name="Killsaw" hidden="false" id="3a8a-69eb-959b-7b9c">
                  <constraints>
                    <constraint type="max" value="2" field="selections" scope="parent" shared="true" id="f790-fd07-cc8b-2f36" includeChildSelections="false"/>
                  </constraints>
                  <infoLinks>
                    <infoLink name="Killsaw" id="95d9-527b-aa81-9de4" hidden="false" type="profile" targetId="7bc6-9c25-bc92-d95a"/>
                  </infoLinks>
                  <costs>
                    <cost name="pts" typeId="cc70-4a02-fa6e-e0b2" value="15"/>
                    <cost name="PL" typeId="edc4-6fbc-a1d5-3d58" value="0"/>
