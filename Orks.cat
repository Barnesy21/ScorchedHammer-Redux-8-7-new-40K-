      <profiles>
        <profile name="Mek Gunz" typeId="10e3-235b-fd89-87a6" typeName="Abillities" hidden="false" id="a80b-ff9d-587c-10a7">
          <characteristics>
            <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">The 1st time this unit is set up on the battlefield, each Mek Gun must be placed within 6&quot; of at least one other Mek Gun, with each Grot Krew within 1&quot; of their Mek Gun. From that point onwards, each Mek Gun operates independently and is treated as a separate unit for all rules purposes.</characteristic>
          </characteristics>
        </profile>
        <profile name="Grot Krew" typeId="10e3-235b-fd89-87a6" typeName="Abillities" hidden="false" id="92bf-65a4-7b76-1106">
          <characteristics>
            <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">Each Mek Gun and its grot krew are treated as a single model for all rules purposes. the Krew must remain within 1&quot; of their Mek Gun and cannot be targeted or attacked separately. The range and visibility of all attacks made by a Mek Gun are measured from the Mek Gun, not the krew.</characteristic>
          </characteristics>
        </profile>
      </profiles>
