            <characteristic name="Powers Known" typeId="7e89-4bd8-8f12-0cf7">Smite &amp; 1 from Power of the WAAAGH!</characteristic>
            <characteristic name="Other" typeId="c046-4b98-ea8c-d36b">-</characteristic>
          </characteristics>
        </profile>
        <profile name="Waaagh! Energy" typeId="10e3-235b-fd89-87a6" typeName="Abillities" hidden="false" id="8edd-c6d8-50e8-6ef8">
          <characteristics>
            <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">Add 1 to any Psychic test rolls made for this model for every 10 friendly ORK models excluding Gretchin within 10&quot; of it when the roll is made, to a maximum of +3. However, if result of the test is 12+, this model immediately suffers Perils of the Warp.</characteristic>
          </characteristics>
        </profile>
        <profile name="Weirdboy Staff" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapons" hidden="false" id="574d-1572-02d0-fecf">
          <characteristics>
