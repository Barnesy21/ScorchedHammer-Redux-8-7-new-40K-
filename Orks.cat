    <profile name="Painboy" typeId="800f-21d0-4387-c943" typeName="Unit" hidden="false" id="395a-d1a3-9083-1665">
      <characteristics>
        <characteristic name="M" typeId="f861-1936-95cc-e6d3">6&quot;</characteristic>
