    <profile name="Mekaniak" typeId="10e3-235b-fd89-87a6" typeName="Abillities" hidden="false" id="c435-373b-8013-16b8">
      <characteristics>
        <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">At the end of your Movement phase, this model can repair a single friendly VEHICLE within 1&quot;. That model regains 1 wound lost earlier in the battle. A vehicle can only be repaired once each turn.</characteristic>
      </characteristics>
    </profile>
