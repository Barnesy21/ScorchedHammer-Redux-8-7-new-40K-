    <profile name="Mekaniak" typeId="10e3-235b-fd89-87a6" typeName="Abillities" hidden="false" id="c435-373b-8013-16b8">
      <characteristics>
        <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">This model has the Battlesmith(3+) Special rule However if this model rolls a 1 when atempting to repair the vehicle, Roll a D6, on a 1 the vehicle explodes, on a 2-3 this model suffers D3 mortal Wounds, on a 4-6 nothing happens.</characteristic>
      </characteristics>
    </profile>
