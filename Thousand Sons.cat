        <profile name="Crazed" typeId="10e3-235b-fd89-87a6" typeName="Abillities" hidden="false" id="38c8-c550-e817-3133">
          <characteristics>
            <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">At the end of any phase in which this model suffers any unsaved wounds or mortal wounds, roll a D6. On a roll of 6, this model immediately makes a shooting attack as if it were your Shooting phase if there no enemies within 1&quot;, or piles in and fights as if it were in the Fight phase if there are enemies within 1&quot;. If there is no visible target within range, nothing happens.</characteristic>
          </characteristics>
        </profile>
      </profiles>
