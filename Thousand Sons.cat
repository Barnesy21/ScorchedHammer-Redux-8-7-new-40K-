      <profiles>
        <profile name="Warp Implosion" typeId="10e3-235b-fd89-87a6" typeName="Abillities" hidden="false" id="1b8f-f146-fe0a-1feb">
          <characteristics>
            <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">If this model is reduced to 0 wounds, roll a D6 before removing it from the battlefield; on a 6 those nearby are damaged by searing warpfire as the vortex collapses in on itself and each unit within 6&quot; suffers D6 mortal wounds.</characteristic>
          </characteristics>
        </profile>
        <profile name="Unstable Energies" typeId="10e3-235b-fd89-87a6" typeName="Abillities" hidden="false" id="6770-d3fd-163a-84a4">
          <characteristics>
            <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">If this model has 7 or fewer wounds remaning at the start of your Shooting phase, the ranges of its Mutalith Vortex powers are doubled; however, it will suffer a mortal wound if you roll a 1 when the model attempts to use a power.</characteristic>
          </characteristics>
        </profile>
        <profile name="Mutant Regeneration" typeId="10e3-235b-fd89-87a6" typeName="Abillities" hidden="false" id="d5a6-7350-675e-eff8">
          <characteristics>
            <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">At the beginning of each of your turns, this model regains 1 lost wound.</characteristic>
          </characteristics>
        </profile>
        <profile name="Aura of Dark Glory" typeId="10e3-235b-fd89-87a6" typeName="Abillities" hidden="false" id="6162-8fec-eb6e-94e6">
