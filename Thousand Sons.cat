          </constraints>
          <profiles>
            <profile name="Glamour of Tzeentch" typeId="f7ae-1618-90a8-558c" typeName="Psychic Power (Augment/HEX)" hidden="false" id="e64b-6628-d21b-625b">
              <characteristics>
                <characteristic name="Warp Charge" typeId="073a-3360-beab-6247">7</characteristic>
                <characteristic name="Range" typeId="59ce-10fb-8689-2d17">12&quot;</characteristic>
                <characteristic name="Details" typeId="f78e-01c6-7e67-f2db">If manifested, select a friendly THOUSAND SONS unit within 12&quot; of the psyker. Until the start of your next Psychic phase, your opponent must subtract 1 from any hit rolls they make for models that target that unit.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
