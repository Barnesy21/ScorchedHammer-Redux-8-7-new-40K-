        <profile name="Slashing Dive" typeId="10e3-235b-fd89-87a6" typeName="Abillities" hidden="false" id="724c-292c-6692-813e">
          <characteristics>
            <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">In your Movement phase, after this unit ends a Normal move, you can select one enemy unit it moved over during that move and roll one D6 for each model in this unit: for each 4+, that enemy unit suffers 1 mortal wound.</characteristic>
          </characteristics>
        </profile>
