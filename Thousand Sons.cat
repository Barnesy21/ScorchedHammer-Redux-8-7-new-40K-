      </categoryLinks>
      <costs>
        <cost name="pts" typeId="cc70-4a02-fa6e-e0b2" value="445"/>
        <cost name="PL" typeId="edc4-6fbc-a1d5-3d58" value="0"/>
        <cost name="CP" typeId="3e73-ebb4-4a79-ba46" value="0"/>
      </costs>
      <profiles>
        <profile name="Magnus The Red" typeId="800f-21d0-4387-c943" typeName="Unit" hidden="false" id="adea-7261-a673-b58b">
          <characteristics>
            <characteristic name="M" typeId="f861-1936-95cc-e6d3">*</characteristic>
            <characteristic name="WS" typeId="6d32-22be-cfa3-e21b">2+</characteristic>
            <characteristic name="BS" typeId="a1a2-1b7c-7431-d43d">2+</characteristic>
            <characteristic name="S" typeId="ffee-9c9b-6655-d843">8</characteristic>
            <characteristic name="T" typeId="7dd6-7000-6498-6a92">7</characteristic>
            <characteristic name="W" typeId="f05f-2129-62a8-9a30">18</characteristic>
            <characteristic name="A" typeId="d794-d261-842e-1ef8">*</characteristic>
            <characteristic name="Ld" typeId="95fd-4f19-4acc-61f8">10</characteristic>
            <characteristic name="Save" typeId="952f-14da-4484-d1ea">3+</characteristic>
          </characteristics>
        </profile>
        <profile name="Blade of Magnus" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapons" hidden="false" id="6b38-38f7-a920-dfcc">
          <characteristics>
            <characteristic name="Range" typeId="4c40-c12d-8d74-1fe7">Melee</characteristic>
            <characteristic name="Type" typeId="b392-8288-2208-6ab2">Melee</characteristic>
            <characteristic name="S" typeId="b6e6-61d9-0a48-2696">+2</characteristic>
            <characteristic name="AP" typeId="15b5-fbf0-b823-d985">-4</characteristic>
            <characteristic name="D" typeId="805f-6ece-e727-1ac1">3</characteristic>
            <characteristic name="Abilities" typeId="90e1-1023-d27e-1bb2">If a CHARACTER is destroyed by this weapon, you can add a Chaos Spawn to your army. Set up the Chaos Spawn within 6&quot; of Magnus and more than 1&quot; from any enemy models.</characteristic>
          </characteristics>
        </profile>
        <profile name="Magnus The Red" typeId="731e-9ee6-c9e5-305a" typeName="Psyker" hidden="false" id="408d-ffd9-164f-e306">
          <characteristics>
            <characteristic name="Cast" typeId="ab6d-5995-d985-b192">3</characteristic>
            <characteristic name="Deny" typeId="9a3f-a270-5f77-8e90">3</characteristic>
            <characteristic name="Powers Known" typeId="7e89-4bd8-8f12-0cf7">Smite and three powers from any of the Disciplines he as access to</characteristic>
            <characteristic name="Other" typeId="c046-4b98-ea8c-d36b"/>
          </characteristics>
        </profile>
        <profile name="Crown of the Crimson King" typeId="10e3-235b-fd89-87a6" typeName="Abillities" hidden="false" id="6976-a948-1e2b-4deb">
          <characteristics>
            <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">Magnus the Red has a 4+ invulnerable save. In addition, roll a D6 whenever Magnus suffers a mortal wound as a result of Perils of the Warp, on a roll of 2+, that wound is ignored.</characteristic>
          </characteristics>
        </profile>
        <profile name="Primarch of the Thousand Sons" typeId="10e3-235b-fd89-87a6" typeName="Abillities" hidden="false" id="20e9-83a2-9fbc-8e9f">
          <characteristics>
            <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">You can re-roll hit rolls of 1, and any dice rolls of 1 that are made as part of a Psychic test, for friendly THOUSAND SONS units within 9&quot; of Magnus the Red.</characteristic>
          </characteristics>
        </profile>
        <profile name="Gaze of Magnus" typeId="10e3-235b-fd89-87a6" typeName="Abillities" hidden="false" id="dffa-4a11-76a9-f270">
          <characteristics>
            <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">If Magnus manifests the Smite power, he inflicts D6 mortal wounds instead of D3, or 2D6 mortal wounds instead of D6 if the result of the Psychic test is more than 11 . This has been included in the profile for Smite.</characteristic>
          </characteristics>
        </profile>
        <profile name="Unearthly Power" typeId="10e3-235b-fd89-87a6" typeName="Abillities" hidden="false" id="7492-6836-c37e-aeb6">
          <characteristics>
            <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">Whenever Magnus the Red attempts to manifest or deny a psychic power, add the bonus shown in his damage table to his Psychic test or Deny the Witch test.</characteristic>
          </characteristics>
        </profile>
        <profile name="Magnus The Red" typeId="8ad6-25e8-ab32-0154" typeName="Wound Track" hidden="false" id="f4d6-8afb-05e0-81e5">
          <characteristics>
            <characteristic name="Remaining W" typeId="b769-51c6-78d5-808f">-</characteristic>
            <characteristic name="Characteristic 1" typeId="7c82-83ad-ae83-6c9c">M</characteristic>
            <characteristic name="Characteristic 2" typeId="e536-5322-b3be-015b">A</characteristic>
            <characteristic name="Characteristic 3" typeId="761a-8ad0-7003-6d85">Psychic Phase Bonus</characteristic>
          </characteristics>
        </profile>
        <profile name="Magnus The Red" typeId="8ad6-25e8-ab32-0154" typeName="Wound Track" hidden="false" id="c458-2b9e-0e4b-f207">
