        <profile name="Rage Embodied (Aura)" typeId="10e3-235b-fd89-87a6" typeName="Abillities" hidden="false" id="b6da-bee2-b13b-e35f">
          <characteristics>
            <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">While a unit is within 6&quot; of this model:


Add 1 to the Attacks characteristic of models in that unit.


Each time a Morale test is made for that unit, it is automatically passed.


Each time that unit is selected to Fall Back, the controlling player rolls 3D6. If the total is greater than that unit&apos;s Leadership characteristic, that unit cannot Fall Back.</characteristic>
          </characteristics>
        </profile>
        <profile name="Witchbane" typeId="10e3-235b-fd89-87a6" typeName="Abillities" hidden="false" id="bb7a-1a62-117b-f9a3">
          <characteristics>
            <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">This unit cannot be targeted or affected by psychic powers.</characteristic>
          </characteristics>
        </profile>
      </profiles>
