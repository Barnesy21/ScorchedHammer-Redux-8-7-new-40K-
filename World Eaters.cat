    <profile name="Icon of Khorne" typeId="10e3-235b-fd89-87a6" typeName="Abillities" hidden="false" id="dee7-a0a9-f1db-e9d2">
      <characteristics>
        <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">If the Bearers Unit contains 1 or more Icons of Khorne, Each time the Bearers unit destroys an enemy unit gain 1 bloodshed point. 
Each time you make a Blessings of Khorne roll, roll an additional D6 for each bloodshed point you have. after which all Bloodshed points are lost.</characteristic>
      </characteristics>
    </profile>
