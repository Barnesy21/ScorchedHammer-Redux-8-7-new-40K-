        <profile name="Unstoppable Wrath" typeId="10e3-235b-fd89-87a6" typeName="Abillities" hidden="false" id="1334-9f1a-f89d-594d">
          <characteristics>
            <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">This model can make attacks with Blast weapons against units within Engagement Range of it. Each time a ranged attack is made by this model against an enemy unit that is within Engagement Range of it, add 1 to that attack&apos;s hit roll.</characteristic>
          </characteristics>
        </profile>
        <profile name="Titanic Daemon Engine" typeId="10e3-235b-fd89-87a6" typeName="Abillities" hidden="false" id="ee96-c593-6028-b3ad">
          <characteristics>
            <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">This model is eligible to declare a charge in a turn in which it Fell Back. Each time this model makes a Normal Move, Advances or Falls Back, it can be moved across other models (excluding MONSTER and VEHICLE models) as if they were not there, and when it does so it can be moved within Engagement Range of those models, but cannot finish its move within Engagement Range of any of them.</characteristic>
          </characteristics>
        </profile>
      </profiles>
