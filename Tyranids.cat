        <selectionEntry type="upgrade" import="true" name="Cunning Reflexes" hidden="false" id="f016-c076-59fc-3d25">
          <rules>
            <rule name="Cunning Reflexes" id="af4a-f7eb-1030-8c90" hidden="false">
              <description>All Vanguard invader Units have their invulnerable saves increased By +1.</description>
            </rule>
          </rules>
          <constraints>
