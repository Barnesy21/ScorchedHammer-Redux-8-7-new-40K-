        <selectionEntry type="upgrade" import="true" name="Micro Adjustments" hidden="false" id="d04f-f626-917b-940e">
          <rules>
            <rule name="Micro Adjustments" id="13bb-3428-f709-ecb1" hidden="false">
              <description>Vanguard Invader &amp; Endless Multitude Units in your Army may ignore Modifies to Movement, Advancing and Charging</description>
            </rule>
          </rules>
          <constraints>
