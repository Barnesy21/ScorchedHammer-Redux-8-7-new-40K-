      <profiles>
        <profile name="Symbiotic Targeting" typeId="10e3-235b-fd89-87a6" typeName="Abillities" hidden="false" id="28a5-40bf-86f9-db3d">
          <characteristics>
            <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">If this model did not move in its Movement phase, you can add 1 to its hit rolls in the following Shooting phase. If you do so, it cannot charge in the same turn.</characteristic>
          </characteristics>
        </profile>
        <profile name="Weapon Beast" typeId="10e3-235b-fd89-87a6" typeName="Abillities" hidden="false" id="36af-2916-7b7f-e5ff">
          <characteristics>
            <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">If this model does not move in your Movement phase, it can shoot all of its weapons twice in your Shooting phase</characteristic>
          </characteristics>
        </profile>
        <profile name="Death Throes" typeId="10e3-235b-fd89-87a6" typeName="Abillities" hidden="false" id="e924-0b6c-bd41-0338">
          <characteristics>
            <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">If this model is reduced to 0 wounds, roll a dice before removing it from the battlefield; on a 6, it lashes out in its death throes, and each unit within 3&quot; suffers D3 mortal wounds.</characteristic>
          </characteristics>
        </profile>
      </profiles>
