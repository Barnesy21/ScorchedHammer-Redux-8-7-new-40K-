          <characteristics>
            <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">In your Command phase, select one enemy unit within 12&quot; of this model. That unit must take a Leadership test.</characteristic>
          </characteristics>
        </profile>
        <profile name="Psychological Saboteur (Aura)" typeId="10e3-235b-fd89-87a6" typeName="Abillities" hidden="false" id="dd34-34a9-35f5-7547">
          <characteristics>
            <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">While an enemy unit is within 12&quot; of this model, if that unit is Leadership:
Each time a model in that unit makes an attack, subtract 1 from the Hit roll.
Each time a friendly TYRANIDS model makes an attack that targets that unit, add 1 to the Wound roll.</characteristic>
          </characteristics>
