<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<catalogue library="false" id="c792-b782-7a22-fa9f" name="Tyranids" gameSystemId="sys-d1dc-a418-d2d6-9a0a" gameSystemRevision="1" revision="1" battleScribeVersion="2.03" type="catalogue" xmlns="http://www.battlescribe.net/schema/catalogueSchema">
  <sharedRules>
    <rule name="Synapse" id="a415-8e5d-69aa-02f4" hidden="false">
      <description>Models are considered to be within synaps if the unit is within 12&quot; of a synaps beast. While Within Synaps range units gain the Synaptic Directive for the turn.</description>
    </rule>
    <rule name="The Will of the Hivemind" id="4848-1a12-edee-b375" hidden="false">
      <description>Models are considered to be within synaps if the unit is within 24&quot; of a synaps beast. While Within Synaps range units gain the Synaptic Directive for the turn.</description>
    </rule>
    <rule name="Synaptic Backlash Lessor" id="c22c-ce89-e752-35d8" hidden="false">
      <description>When a model with this special rule is slain all friendly non synaps units within 9&quot; Regardless of if another sysnaps Beast is within range. must take a leadership test minus the LD of this model slain. the amount failed by for the LD test is removed as casulties.</description>
    </rule>
    <rule name="Synaptic Backlash Greater" id="ec4f-80c6-71eb-e435" hidden="false">
      <description>When a model with this special rule is slain all friendly non synaps units within 18&quot; Regardless of if another sysnaps Beast is within range. must take a leadership test minus the LD of this model slain. the amount failed by for the LD test is removed as casulties.</description>
    </rule>
    <rule name="Instincitve Behaviour" id="82a5-7292-5e79-ef8e" hidden="false">
      <description>Unless a Unit with this Ability is within 24&quot; of a Synapse Creature, You must take a Ld Test, If you pass the unit may act as normal, if you fail,the unit must target the closest enemy unit in the Shooting Charge and close combat phase. If a model with this rule is wholly within 3&quot; of a Synapse Beast whenever the model is targeted by a attack, roll a D6 on a 4+ this model takes the hit instead of the Synapse Creature.</description>
    </rule>
    <rule name="Shadow in the Warp" id="9016-82fe-c277-2be5" hidden="false">
      <description>Enemy PSKYERS must subtract 1 from any Psychic tests they make if they are within 18&quot; of any units with this ability. TYRANID PSYKERS are not affected.</description>
    </rule>
  </sharedRules>
  <sharedSelectionEntries>
    <selectionEntry type="upgrade" import="true" name="Synaptic Directive" hidden="false" id="2c25-9edd-0307-40bf">
      <selectionEntries>
        <selectionEntry type="upgrade" import="true" name="Swarming Tactics" hidden="false" id="b1ab-7bf8-6f53-3c57">
          <rules>
            <rule name="Swarming Tactics" id="5d98-5e71-02e9-3016" hidden="false">
              <description>Endless Multitude Models in your army may Advance and Shoot without Penalty as if they had assault Weapons</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Monstrous Aggression" hidden="false" id="dd30-2757-ea1f-0db3">
          <rules>
            <rule name="Monstrous Aggression" id="9c7f-0459-0d8a-0e24" hidden="false">
              <description>Models with the Monster Keyword gain the Devastating Wounds and Rending Special rules on there weapons</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Hunting Preditors" hidden="false" id="bac4-675e-a874-c647">
          <rules>
            <rule name="Hunting Preditors" id="c2bc-d7a8-af5a-bd07" hidden="false">
              <description>Vanguard Invader Units in your army are eligble to Charge in a turn in which they fell back or advanced</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Hyper Aggression" hidden="false" id="d3d0-0b2c-dff4-847e">
          <rules>
            <rule name="Hyper Aggression" id="3a9c-d67b-3d67-528c" hidden="false">
              <description>Endless Multitude and Harvister Models in your army have the sustained Hit special rule</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Cunning Instincts" hidden="false" id="cac8-2924-5c3f-d10d">
          <rules>
            <rule name="Cunning Instincts" id="d52c-2c2c-432c-da82" hidden="false">
              <description>Synapse Models in your army have the Sustained Hits 2 Special Rule on all Melee Weapons</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Endless Swarm" hidden="false" id="7529-b091-7c07-bc52">
          <rules>
            <rule name="Endless Swarm" id="de77-8e0b-4a85-687b" hidden="false">
              <description>Endless Multitude Units from your army at the beginning of each turn roll a D6 for each slain model in the unit on a 3+ Return the model to the unit</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Surprise Assault" hidden="false" id="4966-c017-483c-e94c">
          <rules>
            <rule name="Suprise Assault" id="345f-a773-5214-1681" hidden="false">
              <description>Endless Multitude and Vanguard Invader Units in your army Have the Shrouded Special Rule</description>
            </rule>
          </rules>
        </selectionEntry>
      </selectionEntries>
      <constraints>
        <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="00d8-e1b1-59c1-3dec-min" includeChildSelections="false"/>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="00d8-e1b1-59c1-3dec-max" includeChildSelections="false"/>
        <constraint type="max" value="3" field="selections" scope="parent" shared="true" id="6e94-f9aa-3689-201c" includeChildSelections="false"/>
      </constraints>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Hive Fleet" hidden="false" id="01e6-ec0c-5ab9-3c43">
      <selectionEntries>
        <selectionEntry type="upgrade" import="true" name="Behemoth" hidden="false" id="0677-3e35-0306-ee5b">
          <rules>
            <rule name="Hyper-aggression: " id="158e-aa3b-34a7-5e3a" hidden="false">
              <description>You can re-roll failed charge rolls for units with this adaption.</description>
            </rule>
          </rules>
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="88c8-da6c-dd61-e296" includeChildSelections="false"/>
          </constraints>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Gorgon" hidden="false" id="c0f7-dda4-d6e1-6b05">
          <rules>
            <rule name="Adaptive Toxins" id="1bd5-5498-82c7-dbf8" hidden="false">
              <description>You can re-roll wound rolls of 1 in the Fight phase for units with this adaption.</description>
            </rule>
          </rules>
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="ad6e-602f-793e-a1e4" includeChildSelections="false"/>
          </constraints>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Hydra" hidden="false" id="5b98-6d69-1846-4843">
          <rules>
            <rule name="Swarming Insects" id="170c-a29b-e335-9f1a" hidden="false">
              <description>You can re-roll hit rolls in the Fight phase for units with this adaption that target units containing fewer models than their own.</description>
            </rule>
          </rules>
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="c916-7c60-0766-4a28" includeChildSelections="false"/>
          </constraints>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Jormungandr" hidden="false" id="479b-5ca0-fbc6-aa33">
          <rules>
            <rule name="Tunnel Networks" id="0cd3-ee75-61df-6a4a" hidden="false">
              <description>A unit with this adaption (other than units that can FLY) always has the benefit of cover for the purposes of shooting. If the unit Advances or declares a charge, however, it loses the benefit of this adaptation until the start of your next Movement phase.</description>
            </rule>
          </rules>
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="ae7f-692e-c14f-c99f" includeChildSelections="false"/>
          </constraints>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Kraken" hidden="false" id="bd51-e406-7ef3-e59d">
          <rules>
            <rule name="Questing Tendrils" id="83b4-88e3-6b4b-78ec" hidden="false">
              <description>When a unit with this adaption Advances, roll three dice and pick the highest to add to the Move characteristic of all models in the unit for that Movement phase. In addition, such units can Fall Back and charge in the same turn.</description>
            </rule>
          </rules>
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="df82-2418-7bbb-2a07" includeChildSelections="false"/>
          </constraints>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Kronos" hidden="false" id="dc1b-1ec0-0be3-b3a1">
          <rules>
            <rule name="Bio-barrage" id="3087-64b3-c922-2bbe" hidden="false">
              <description>You can re-roll hit rolls of 1 for units with this adaption in your Shooting phase if they did not move in the preceding Movement phase.</description>
            </rule>
          </rules>
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="d414-8b5a-8ca3-2431" includeChildSelections="false"/>
          </constraints>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Leviathan" hidden="false" id="58a0-a748-5b8d-4c65">
          <rules>
            <rule name="Synaptic Imperative" id="7ff2-936a-d7ae-5204" hidden="false">
              <description>Roll a D6 each time a unit with this adaption loses a wound whilst it is within 6&quot; of a friendly Synapse unit from the same hive fleet. On a 6, the damage is ignored and the unit does not lose a wound. Ignore this adaption on a unit that is currently affected by the Catalyst psychic power.</description>
            </rule>
          </rules>
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="11ba-bbee-3366-80af" includeChildSelections="false"/>
          </constraints>
        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Custom Fleet" hidden="false" id="a7ff-78d0-a4a1-9d51">
          <constraints>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="5ef9-2a2b-8cf7-5540" includeChildSelections="false"/>
          </constraints>
        </selectionEntry>
      </selectionEntries>
      <constraints>
        <constraint type="max" value="1" field="selections" scope="self" shared="true" id="7c9b-d1a5-19af-d541" includeChildSelections="false"/>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="cba2-7f63-0fa6-b77b" includeChildSelections="false"/>
      </constraints>
    </selectionEntry>
