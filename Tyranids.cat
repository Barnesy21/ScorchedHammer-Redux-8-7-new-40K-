          </characteristics>
        </profile>
        <profile name="Support Beast" typeId="10e3-235b-fd89-87a6" typeName="Abillities" hidden="false" id="3fe6-b739-442e-ff31">
          <characteristics>
            <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">This model has a Feel No Pain 5+ Save and Any Friendly models within 6&quot; of this model have a feel no pain 6+ Save.</characteristic>
          </characteristics>
        </profile>
        <profile name="Bio-stimulus" typeId="10e3-235b-fd89-87a6" typeName="Abillities" hidden="false" id="af37-49a4-8d2a-a3a0">
          <characteristics>
            <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">In your Shooting phase, after this model has shot, select one enemy unit hit by one or more of those attacks. Until the end of the turn, each time a friendly TYRANIDS unit makes a melee attack that targets that enemy unit, improve the Armour Penetration characteristic of that attack by 1. The same enemy unit can only be affected by this ability once per turn.</characteristic>
          </characteristics>
        </profile>
        <profile name="Feeding Frenzy" typeId="10e3-235b-fd89-87a6" typeName="Abillities" hidden="false" id="1760-e798-b0d3-8c28">
          <characteristics>
            <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">Each time this model makes a melee attack that targets a unit that is below its Starting Strength, add 1 to the Hit roll. If that target is also Below Half-strength, add 1 to the Wound roll as well.</characteristic>
          </characteristics>
        </profile>
        <profile name="Psychic Cloud" typeId="10e3-235b-fd89-87a6" typeName="Abillities" hidden="false" id="6ba1-291e-a14e-3666">
          <characteristics>
            <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">This model is -1 to hit from shooting attacks outside of 12&quot;, Any enemy model within 12&quot; of this model is -2 to leadership and must take a leadership test.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <categoryLinks>
