      <profiles>
        <profile name="Volatile" typeId="10e3-235b-fd89-87a6" typeName="Abillities" hidden="false" id="97d0-14ae-377e-76c3">
          <characteristics>
            <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">When a Pyrovore is slain, roll a dice. On a 4+ it bursts in a shower of acid - the nearest enemy unit within 3&quot; (if any) suffers a mortal wound.</characteristic>
          </characteristics>
        </profile>
        <profile name="Acid Blood" typeId="10e3-235b-fd89-87a6" typeName="Abillities" hidden="false" id="3937-e6d0-6b58-9604">
          <characteristics>
            <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">Each time this model loses a wound in the Fight phase, roll a D6; on a 6, the unit that inflicted the damage suffers a mortal wound after all of their attacks have been resolved.</characteristic>
          </characteristics>
        </profile>
      </profiles>
