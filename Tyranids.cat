          <characteristics>
            <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">This model does not suffer the penalty to its hit rolls for moving and firing Heavy weapons.</characteristic>
          </characteristics>
        </profile>
        <profile name="Weapon Beast" typeId="10e3-235b-fd89-87a6" typeName="Abillities" hidden="false" id="652d-8017-3d7d-74c6">
          <characteristics>
            <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">If this model does not move in your Movement phase, it can shoot all of its weapons twice in your Shooting phase.</characteristic>
          </characteristics>
        </profile>
        <profile name="Death Throes" typeId="10e3-235b-fd89-87a6" typeName="Abillities" hidden="false" id="6e45-b1d3-2c1c-34a1">
          <characteristics>
            <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">If this model is reduced to 0 wounds, roll a dice before removing it from the battlefield; on a 6, it lashes out in its death throes, and each unit within 3&quot; suffers D3 mortal wounds.</characteristic>
          </characteristics>
        </profile>
      </profiles>
