          <constraints>
            <constraint type="min" value="3" field="selections" scope="parent" shared="true" id="7c2d-e582-6bbc-8fa2" includeChildSelections="false"/>
            <constraint type="max" value="6" field="selections" scope="parent" shared="true" id="a744-1c6a-c255-1c9d" includeChildSelections="false"/>
          </constraints>
        </selectionEntry>
      </selectionEntries>
      <profiles>
        <profile name="Shrouding Spores" typeId="10e3-235b-fd89-87a6" typeName="Abillities" hidden="false" id="ced8-02a5-7d89-b39b">
          <characteristics>
            <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">Your opponent must subtract 1 from hit rolls made for ranged weapons that target units (excluding MONSTERS) whilst they are within 6&quot; of any Venomthropes. In addition, your opponent must subtract 1 from hit rolls made for ranged weapons that target MONSTERS whilst they are within 6&quot; of any Venomthrope units that contain 3 or more models. Increase the range of both these effects to 9&quot; whilst this unit contains 6 models.</characteristic>
          </characteristics>
        </profile>
        <profile name="Toxic Miasma" typeId="10e3-235b-fd89-87a6" typeName="Abillities" hidden="false" id="140d-6758-c984-ee82">
          <characteristics>
            <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">At the end of the Fight phase, roll a D6 for each enemy unit within 1&quot; of any Venomthropes. On a 5+, that unit suffers a mortal wound.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <infoLinks>
        <infoLink name="Instincitve Behaviour" id="1675-c538-1965-2224" hidden="false" type="rule" targetId="82a5-7292-5e79-ef8e"/>
      </infoLinks>
