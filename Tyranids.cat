        </selectionEntry>
        <selectionEntry type="upgrade" import="true" name="Cunning Ambush" hidden="false" id="fbd3-17b5-2f5f-2e54">
          <rules>
            <rule name="Cunning Ambush" id="ae80-1452-b275-2685" hidden="false">
              <description>Vanguard Invader Units in your Army may Make a Normal move During your shooting Phase.</description>
            </rule>
          </rules>
          <constraints>
            <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="b2bb-87a1-51be-6198" includeChildSelections="true" includeChildForces="true"/>
