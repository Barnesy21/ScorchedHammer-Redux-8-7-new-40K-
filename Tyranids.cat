          </characteristics>
        </profile>
        <profile name="Leaper-killer" typeId="10e3-235b-fd89-87a6" typeName="Abillities" hidden="false" id="4137-5bb1-f82f-43e0">
          <characteristics>
            <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">When this model moves, do not count any vertical distance it moves against the total it may travel.</characteristic>
          </characteristics>
        </profile>
        <profile name="Digestion Spine" typeId="10e3-235b-fd89-87a6" typeName="Abillities" hidden="false" id="2126-4869-d9a2-535a">
          <characteristics>
            <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">If a Dimachaeron kills one or more enemy INFANTRY models in the Fight phase with its gasping talons and thorax spine-maw, it gains a 5+ invulnerable save for the remainder of the battle.</characteristic>
          </characteristics>
        </profile>
