    <profile name="Simulacrum Imperialis" typeId="10e3-235b-fd89-87a6" typeName="Abillities" hidden="false" id="ef1a-8b10-9edf-8c57">
      <characteristics>
        <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">During your Command Phase, Roll a D6 on a 5+ Gain 1 Miracle dice, if this unit is on an objective on a 3+ Gain 1 Miracle Dice</characteristic>
      </characteristics>
    </profile>
    <profile name="Arco-flails" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapons" hidden="false" id="2110-92af-09c8-74ef">
