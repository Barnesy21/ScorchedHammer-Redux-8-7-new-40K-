                  <characteristics>
                    <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">You can re-roll Deny the Witch tests taken for models in units whilst their unit is within 6” of any friendly models with this ability.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntry>
