        <characteristic name="Abilities" typeId="90e1-1023-d27e-1bb2">Sweeping D3, Gets Hot</characteristic>
      </characteristics>
    </profile>
    <profile name="Incensor Cherub" typeId="10e3-235b-fd89-87a6" typeName="Abillities" hidden="false" id="2e4c-1be5-d40c-aa9e">
      <characteristics>
        <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">If this unit has an Incensor Cherub, then once per battle, at the beginning of a phase, that Incensor Cherub can intercede. if it does, that Incensor Cherub is removed from play and you gain one Miracle Dice. Roll two D6 when you do so and select which one to keep. The Miracle Dice you gain can only be used to perform an Act of Faith for this unit, and only in that phase - at the end of this phase, if the dice has not been used, it is lost.</characteristic>
      </characteristics>
    </profile>
    <profile name="Shield of Faith" typeId="10e3-235b-fd89-87a6" typeName="Abillities" hidden="false" id="07ae-d6ca-2b7d-7bf6">
      <characteristics>
        <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">As Long as this Unit is not broken this unit has a 6+ Invulnerable save.</characteristic>
      </characteristics>
    </profile>
    <profile name="Neural whips" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapons" hidden="false" id="36a2-ee1c-132c-c068">
