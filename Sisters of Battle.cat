        <characteristic name="D" typeId="805f-6ece-e727-1ac1">1</characteristic>
        <characteristic name="Abilities" typeId="90e1-1023-d27e-1bb2">Add 1 to wound roles when targeting models with a Leadership higher then 7</characteristic>
      </characteristics>
    </profile>
    <profile name="Penitent Eviscerator" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapons" hidden="false" id="e5e6-81d1-3ecb-d8f4">
