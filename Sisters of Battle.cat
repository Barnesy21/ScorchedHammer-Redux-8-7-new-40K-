              <profiles>
                <profile name="Tale of the Warrior" typeId="10e3-235b-fd89-87a6" typeName="Abillities" hidden="false" id="3570-dbfa-7af2-ece4">
                  <characteristics>
                    <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">Add 1 to the Strength characteristics of models in units whilst their unit is within 6” of any friendly models with this ability.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Tale of the Stoic" hidden="false" id="db42-4859-8887-6a31">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="e633-1019-b907-ada5" includeChildSelections="false"/>
              </constraints>
              <profiles>
                <profile name="Tale of the Stoic" typeId="10e3-235b-fd89-87a6" typeName="Abillities" hidden="false" id="c8ca-a17c-95fc-0c6b">
                  <characteristics>
                    <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">Weapons with an Armor Penetration characteristic of -1 are treated as having an armor penetration characteristic of 0 when resolving attacks against units whilst they are within 6” of any friendly models with this ability.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Tale of the Faithful" hidden="false" id="0ffc-94fb-8efc-20b5">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="0985-8925-2c70-3c73" includeChildSelections="false"/>
