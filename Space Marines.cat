        <profile name="Inspiring Commnader" id="faa5-f025-fb47-3b47" hidden="false" typeId="10e3-235b-fd89-87a6" typeName="Abillities">
          <characteristics>
            <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">If you include this model in your army, until the end of the battle, non-CHARACTER models in HEAVY INTERCESSOR SQUAD units from your army have an Objective Control characteristic of 4 while they are not Battle-shocked.</characteristic>
          </characteristics>
