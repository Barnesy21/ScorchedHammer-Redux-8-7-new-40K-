            <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">if you include this model in your army, until the end of the battle, non-CHARACTER models in STERNGUARD VETERAN SQUAD units from your army have an Objective Control characteristic of 2 while they are not Battle-shocked.</characteristic>
          </characteristics>
        </profile>
        <profile name="Oath of Rynn" id="efd3-8b44-1273-5540" hidden="false" typeId="10e3-235b-fd89-87a6" typeName="Abillities">
          <characteristics>
            <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">Once per battle, at the start of either player’s Command phase, this model can use this ability. When it does, until the end of the turn, add 1 to the Attacks characteristic of weapons equipped by models in this model’s unit.</characteristic>
          </characteristics>
        </profile>
        <profile name="Endless Endurence" id="ace8-680e-86dc-5897" hidden="false" typeId="10e3-235b-fd89-87a6" typeName="Abillities">
          <characteristics>
            <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">This Model has a 6+ Feel no Pain</characteristic>
          </characteristics>
        </profile>
        <profile name="To the Last" id="a631-af85-2445-8336" hidden="false" typeId="10e3-235b-fd89-87a6" typeName="Abillities">
          <characteristics>
            <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">While this model is leading a unit, each time a model in that unit makes an attack, add 1 to the Hit roll if that unit is below its Starting Strength, and add 1 to the Wound roll as well if that unit is Below Half-strength.</characteristic>
          </characteristics>
        </profile>
        <profile name="Dorn&apos;s Arrow" id="1b47-dd75-4e51-31c8" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapons">
          <characteristics>
            <characteristic name="Range" typeId="4c40-c12d-8d74-1fe7">24&apos;</characteristic>
            <characteristic name="Type" typeId="b392-8288-2208-6ab2">Rapid Fire 2</characteristic>
            <characteristic name="S" typeId="b6e6-61d9-0a48-2696">5</characteristic>
            <characteristic name="AP" typeId="15b5-fbf0-b823-d985">-1</characteristic>
            <characteristic name="D" typeId="805f-6ece-e727-1ac1">2</characteristic>
            <characteristic name="Abilities" typeId="90e1-1023-d27e-1bb2">Sustained Hits 1</characteristic>
          </characteristics>
        </profile>
        <profile name="Fist of Retribution" id="3ef8-5a5d-193c-90d2" hidden="false" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapons">
