                <constraint id="7589-4303-dd37-6c3c" field="selections" includeChildSelections="false" scope="self" shared="true" type="min" value="1"/>
                <constraint id="d999-f175-fda8-29a3-min" field="selections" includeChildSelections="false" scope="parent" shared="true" type="min" value="1"/>
