        <profile name="Unto the Anvil" id="193e-4dc4-8797-3d6a" hidden="false" typeId="10e3-235b-fd89-87a6" typeName="Abillities">
          <characteristics>
            <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">Add 1 to wound rolls for attacks made with melee weapons by models in friendly SALAMANDERS units whilst their unit is within 6&quot; of this model and if that unit made a charge move, was charged or performed a Heroic Intervention this turn.</characteristic>
