            <characteristic name="S" typeId="b6e6-61d9-0a48-2696">8</characteristic>
            <characteristic name="AP" typeId="15b5-fbf0-b823-d985">-3</characteristic>
            <characteristic name="D" typeId="805f-6ece-e727-1ac1">2</characteristic>
