        <selectionEntry name="Living Lightning" id="993d-8dd0-beb6-062c" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="4b57-6dc6-9c3f-fe75" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Living Lightning" id="3705-56fc-c183-2f2f" hidden="false" typeId="e57e-15c3-e702-5811" typeName="Psychic Power Weapon">
              <characteristics>
                <characteristic name="Cast" typeId="b070-88f4-6531-deb7">6</characteristic>
                <characteristic name="Range" typeId="257a-022c-bfc5-a51f">18&quot;</characteristic>
                <characteristic name="Type" typeId="6bc2-4191-d0d9-71d5">Assault D3</characteristic>
                <characteristic name="S" typeId="a4b2-ce42-4524-4475">6</characteristic>
                <characteristic name="AP" typeId="ad1a-ecf9-b29f-0f6a">-2</characteristic>
                <characteristic name="D" typeId="4249-543a-3dc5-4143">D3</characteristic>
                <characteristic name="Abilities" typeId="7b54-f22e-32e3-b559">Psychic Weapon, Living Lightning</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="Living Lightning" id="22a0-a013-9ee4-92a3" hidden="false">
              <description>After an attack with this weapon is made Roll a  D6 on a 2-4 the closest Enemy unit is also hit with this attack however the damage is changed to 1, if a 5 or 6 was rolled the damage stays at D3.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Murderous Hurricane" id="5f5f-6e26-e607-2b70" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="f4a6-06c4-05cc-de68" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Murderous Hurricane" id="cd0a-0815-b448-9d63" hidden="false" typeId="f7ae-1618-90a8-558c" typeName="Psychic Power (Augment/HEX)">
              <characteristics>
                <characteristic name="Warp Charge" typeId="073a-3360-beab-6247">6</characteristic>
                <characteristic name="Range" typeId="59ce-10fb-8689-2d17">18&quot;</characteristic>
                <characteristic name="Details" typeId="f78e-01c6-7e67-f2db">The Unit targeted by this ability may not fire overwatch if the unit is within a terrain feature, and the target unit may not fight until all Space Wolf Units have fought first.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Tempest&apos;s Wrath" id="b6d3-7b3b-370d-1360" hidden="false" import="true" type="upgrade">
