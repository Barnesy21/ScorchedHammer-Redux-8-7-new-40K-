          <profiles>
            <profile name="Seekers of the Unfound" id="7444-89c5-72d9-7d60" hidden="false" typeId="10e3-235b-fd89-87a6" typeName="Abillities">
              <characteristics>
                <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">This model when it is first placed on the Battlefield and While this model in on the Battlefield, he may select one objective to be his chosen objective, while this model is in capture range of the objective, He is always considered to have control of the objective marker, and this model has a 4+ Feel no Pain.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="Inspiring commander" id="d308-5c1f-1ef2-cc9c" hidden="false">
              <description>Space Marines in this army equipped with Pyre Blasters, Pyre Cannons, Flamers and Heavy Flamers are +1 to the Objective control of each marine in the unit</description>
            </rule>
          </rules>
        </selectionEntry>
      </selectionEntries>
    </selectionEntry>
