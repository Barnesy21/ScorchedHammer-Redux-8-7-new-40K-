      <profiles>
        <profile name="Stone Wall" id="2e3e-cf23-748f-0783" hidden="false" typeId="f7ae-1618-90a8-558c" typeName="Psychic Power (Augment/HEX)">
          <characteristics>
            <characteristic name="Warp Charge" typeId="073a-3360-beab-6247">7</characteristic>
            <characteristic name="Range" typeId="59ce-10fb-8689-2d17">6&quot;</characteristic>
            <characteristic name="Details" typeId="f78e-01c6-7e67-f2db">All Friendly models wholly within 9&quot; of this model cannot be targeted by ranged attacks that are outside 10&quot; Friendly Models wholly within 9&quot; of this model cannot Target enemy Models outside of 10&quot;. During this shooting Phase.</characteristic>
          </characteristics>
        </profile>
        <profile name="(BR) Chief Librarian Jonah Orion" id="92e0-4e2c-32c9-5b8c" hidden="false" typeId="f7ae-1618-90a8-558c" typeName="Psychic Power (Augment/HEX)">
          <characteristics>
            <characteristic name="Warp Charge" typeId="073a-3360-beab-6247">8</characteristic>
            <characteristic name="Range" typeId="59ce-10fb-8689-2d17">9&quot;</characteristic>
            <characteristic name="Details" typeId="f78e-01c6-7e67-f2db">All Friendly Models wholly within 9&quot; of the Psyker have the sustained hits 1 Special Rule and have +2 to their save to a maxinum of a 2+ until the end of the shooting phase.</characteristic>
          </characteristics>
        </profile>
