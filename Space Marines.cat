      <profiles>
        <profile name="Glory of Ultramar" id="e4a2-c07a-f308-f1e1" hidden="false" typeId="10e3-235b-fd89-87a6" typeName="Abillities">
          <characteristics>
            <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">Timing: your opponent&apos;s Shooting phase, once an enemy unit finished shooting



Condition: ≥1 of this unit&apos;s models died to those attacks; this unit is not Battle-shocked and has no enemy unit within Engagement Range


Result: this unit may make a Surge move (optional), max 1× per phase


roll 1D6; each model moves up to that many inches


unit ends the move nearest the closest enemy unit (Aircraft excluded)


moving models may finish inside Engagement Range of that foe</characteristic>
          </characteristics>
        </profile>
        <profile name="Dual Blades" id="eee9-0479-9447-3660" hidden="false" typeId="10e3-235b-fd89-87a6" typeName="Abillities">
          <characteristics>
            <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">When a model in this unit is equipped with 2 Melee weapons one weapon they are equipped with gains the bonus attacks 3 SR at the start of each combat phase.</characteristic>
          </characteristics>
        </profile>
