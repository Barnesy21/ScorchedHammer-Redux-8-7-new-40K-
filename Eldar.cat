    <profile name="Ghosthelm" typeId="10e3-235b-fd89-87a6" typeName="Abillities" hidden="false" id="daf1-f655-e8b2-0852">
      <characteristics>
        <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">Roll a D6 whenever this model suffers a mortal wound, adding 3 to the roll if the mortal wound was inflicted as a result of the Psyker suffering Perils of the Warp. On a roll of 5+, that wound is ignored.</characteristic>
      </characteristics>
    </profile>
    <profile name="Runes of the Farseer" typeId="10e3-235b-fd89-87a6" typeName="Abillities" hidden="false" id="835a-0326-7da7-01c2">
      <characteristics>
        <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">Once in each Psychic phase, you can re-roll any number of dice used for this model&apos;s attempt to manifest or deny a psychic power.</characteristic>
      </characteristics>
    </profile>
    <profile name="Spirit Mark" typeId="10e3-235b-fd89-87a6" typeName="Abillities" hidden="false" id="2b6a-08ab-5ade-0f5c">
