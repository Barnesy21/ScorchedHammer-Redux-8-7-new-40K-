              </constraints>
              <infoLinks>
                <infoLink targetId="86a6-6db9-90f2-b51e" id="1c47-d72c-dffc-d9ed" type="profile" name="Autarch Wayleaper" hidden="false"/>
              </infoLinks>
              <profiles>
                <profile name="Skyleap" typeId="10e3-235b-fd89-87a6" typeName="Abillities" hidden="false" id="aace-2dbf-3042-a72f">
                  <characteristics>
                    <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">At the beginning of your Movement phase, if this model is not within 1&quot; of an enemy model it can leap back into the skies. Remove this model from the battlefield. It can return to the battlefield as described in the Children of Baharroth ability. This model may not both Skyleap and descend on Swooping Hawk wings in the same turn. If the battle ends while this model is in the skies, it is considered to be slain.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Children of Baharroth" typeId="10e3-235b-fd89-87a6" typeName="Abillities" hidden="false" id="be90-9f71-0901-bfd3">
                  <characteristics>
                    <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">During deployment, you can set up this model in the skies instead of on the battlefield. At the end of any of your Movement phases this model can descend - set it up anywhere on the battlefield that is more than 9&quot; away from any enemy models.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <categoryLinks>
                <categoryLink targetId="2853-e9f2-7a9e-0e91" id="0939-d06c-dc0c-51a9" primary="false" name="Infantry"/>
