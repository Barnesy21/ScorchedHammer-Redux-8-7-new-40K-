    <profile name="Path of Command" typeId="10e3-235b-fd89-87a6" typeName="Abillities" hidden="false" id="792a-5ecb-3e8f-e024">
      <characteristics>
        <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">During the command Phase Select one Friendly Unit within 6&quot; of this model, that unit may Re-roll Hit Roles of 1. In Addition Whenever the target unit uses a stratagem targeting the unit, roll a D6 on a 6 Refund the command point.</characteristic>
      </characteristics>
    </profile>
