              <characteristics>
                <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">Mark of Khorne and Black Path Models from your army Gain +1 S for all melee weapons.</characteristic>
              </characteristics>
            </profile>
            <profile name="Mark Of Khorne Level 2" id="f413-cc7e-a1f0-8ead" hidden="true" typeId="10e3-235b-fd89-87a6" typeName="Abillities">
              <characteristics>
                <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">Mark of Khorne and Black Path Models from your army Have the Lethal Hits Special Rule on Melee Attacks.</characteristic>
