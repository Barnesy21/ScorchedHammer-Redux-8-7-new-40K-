      <profiles>
        <profile name="Howling Horde" id="4762-bcd6-f24f-c42e" hidden="false" typeId="10e3-235b-fd89-87a6" typeName="Abillities">
          <characteristics>
            <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">Timing: an enemy unit has finished shooting


Condition: this unit lost 1+ models to those attacks (checked once); this unit is not Battle-shocked


Result: this unit may make a Horde move (optional)


roll 1D6: move up to that many inches


it must end the move as near as it can get to the closest enemy unit (AIRCRAFT excluded)


the move may bring its models into Engagement Range of that enemy</characteristic>
          </characteristics>
        </profile>
        <profile name="Unrelenting horde" id="47ef-5902-1e98-72bb" hidden="false" typeId="10e3-235b-fd89-87a6" typeName="Abillities">
          <characteristics>
            <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">Every model in this unit has a Feel no pain 6+ Save.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <selectionEntries>
        <selectionEntry name="Mutant" id="9cc3-8328-986c-3d04" hidden="false" import="true" type="upgrade">
