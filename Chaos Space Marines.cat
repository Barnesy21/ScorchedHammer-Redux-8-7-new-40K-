    <profile name="Icon of Wrath" id="34f2-70e3-d2e5-9031" hidden="false" typeId="10e3-235b-fd89-87a6" typeName="Abillities">
      <characteristics>
        <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">You can re-roll charge rolls for units with an Icon of Wrath.</characteristic>
      </characteristics>
    </profile>
    <profile name="Icon of Excess" id="541b-3e3e-88a2-c853" hidden="false" typeId="10e3-235b-fd89-87a6" typeName="Abillities">
      <characteristics>
        <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">A unit with a Icon of Excess has the Lance Charge Special Rule on all there melee weapons, and may Fire one type of weapon twice at the same target if it was not destroyed, if you Split file you cannot shoot twice.</characteristic>
      </characteristics>
    </profile>
    <profile name="Icon of Dispair" id="6632-72d5-11f2-3ee7" hidden="false" typeId="10e3-235b-fd89-87a6" typeName="Abillities">
      <characteristics>
        <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">Enemy units that are within 6&quot; of any units with an Icon of Despair must subtract 1 from their Leadership.</characteristic>
      </characteristics>
    </profile>
    <profile name="Icon of Vengence" id="ea44-5a4a-2dec-18b8" hidden="false" typeId="10e3-235b-fd89-87a6" typeName="Abillities">
      <characteristics>
        <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">Add 1 to the Leadership of all models in a unit that has an Icon of Vengeance.</characteristic>
