          </constraints>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditionGroups>
                <conditionGroup type="and"/>
              </conditionGroups>
              <conditions>
                <condition childId="e9e5-53ca-6e2c-1f04" childName="Mark of Khorne" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="greaterThan" value="1"/>
                <condition childId="b8e8-4ea3-6d6d-6fbc" childName="Mark of Nurgle" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="greaterThan" value="1"/>
                <condition childId="af70-dde7-cc0c-48b9" childName="Mark of Slaanesh" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="greaterThan" value="1"/>
                <condition childId="bae2-5176-bfff-292c" childName="Mark of Tzeentch" field="selections" includeChildForces="true" includeChildSelections="true" scope="roster" shared="true" type="greaterThan" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="The Black Path Level 1" id="21c3-56da-5fcb-aaaa" hidden="false" typeId="10e3-235b-fd89-87a6" typeName="Abillities">
              <characteristics>
                <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">All Non Daemon infantry Units in your army may Choose which ability they want to have active until the end of the turn. Each time you choose an ability you must make a leadership test, if you fail the unit takes D6 Mortal Wounds.

1. Brass Knuckles, This model has the Sustained hits 3 Special Rule.
&gt;

2.Silk Robs, This Model has the fights first ability this turn.
&gt;
3. Pale Garden, All Models in this Unit are -2 to all damage this turn to a Minimum of 0
&gt;
4. Blue Lies, This Model May re-roll hit and damage rolls this turn.
&gt;
5. Free Line, This model gains the Sustained Hits 1, Lance Charge, -1 Damage, and May Re-roll 1&apos;s this turn.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
