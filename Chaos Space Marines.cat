                <characteristic name="S" typeId="a4b2-ce42-4524-4475">7</characteristic>
                <characteristic name="AP" typeId="ad1a-ecf9-b29f-0f6a">-3</characteristic>
                <characteristic name="D" typeId="4249-543a-3dc5-4143">1</characteristic>
                <characteristic name="Abilities" typeId="7b54-f22e-32e3-b559">Psychic Weapon</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Prescience" id="8ccf-452b-9d9c-c918" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="3d5a-5aad-b730-474e" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Prescience" id="6762-1c05-6c9e-a2a3" hidden="false" typeId="f7ae-1618-90a8-558c" typeName="Psychic Power (Augment/HEX)">
              <characteristics>
                <characteristic name="Warp Charge" typeId="073a-3360-beab-6247">7</characteristic>
                <characteristic name="Range" typeId="59ce-10fb-8689-2d17">18&quot;</characteristic>
                <characteristic name="Details" typeId="f78e-01c6-7e67-f2db">If manifested, select a HERETIC ASTARTES unit within 18&quot; of the Psyker. You can add 1 to all hit rolls made for that unit until the start of your next Psychic phase.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Warptime" id="b443-f94d-cecc-1b17" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="44de-c628-19bc-bc61" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Warptime" id="24fa-2762-cfe2-5eed" hidden="false" typeId="f7ae-1618-90a8-558c" typeName="Psychic Power (Augment/HEX)">
              <characteristics>
                <characteristic name="Warp Charge" typeId="073a-3360-beab-6247">6</characteristic>
                <characteristic name="Range" typeId="59ce-10fb-8689-2d17">3&quot;</characteristic>
                <characteristic name="Details" typeId="f78e-01c6-7e67-f2db">If manifested, pick a friendly HERETIC ASTARTES unit within 3&quot; of the Psyker. That unit can immediately move as if it were its Movement phase. You cannot use Warptime on a unit more than once in each Psychic phase.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
