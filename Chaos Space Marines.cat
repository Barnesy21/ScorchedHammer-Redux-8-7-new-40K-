          </constraints>
          <profiles>
            <profile name="Temporal Manipulation" id="d568-4e1d-ff31-3e4b" hidden="false" typeId="f7ae-1618-90a8-558c" typeName="Psychic Power (Augment/HEX)">
              <characteristics>
