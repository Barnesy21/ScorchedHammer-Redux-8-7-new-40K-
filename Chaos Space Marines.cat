    <selectionEntry name="Prayers of the Dark Gods" id="c291-4cba-ee36-458d" hidden="false" import="true" type="upgrade">
      <constraints>
        <constraint id="6c7e-1b87-337f-5d20-min" field="selections" includeChildSelections="false" scope="parent" shared="true" type="min" value="1"/>
        <constraint id="6c7e-1b87-337f-5d20-max" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Dark Zealotry" id="f09c-5546-3cd9-1453" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="eec2-0b75-3254-a1da" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="2cac-e56d-8423-16f7-min" field="selections" includeChildSelections="false" scope="parent" shared="true" type="min" value="1"/>
            <constraint id="2cac-e56d-8423-16f7-max" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Dark Zealotry" id="b0a9-cfa5-e4da-f4db" hidden="false" typeId="10e3-235b-fd89-87a6" typeName="Abillities">
              <characteristics>
                <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">If this prayer is heard, then while a friendly &lt;Chaos&gt; Infantry or &lt;Chaos&gt; CHARACTER unit is within 6&quot; of this PRIEST, each time a model in that unit makes a melee attack, you can re-roll the hit roll.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Illusionary Supplication" id="12d6-2cc6-0cf4-9305" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="410a-1139-0a16-b941" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Illusionary Supplication" id="9f74-91b3-4ba3-0a47" hidden="false" typeId="10e3-235b-fd89-87a6" typeName="Abillities">
              <characteristics>
                <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">If this prayer is heard, select one friendly &lt;Chaos&gt; Infantry, or &lt;Chaos&gt; CHARACTER unit within 6&quot; of this PRIEST. Each time an attack is made against that unit: An unmodified hit roll of 1-3 for that attack fails, irrespective of any abilities that the weapon or the model making the attack may have. That attack’s hit roll cannot be re-rolled.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Soultearer Portent" id="a5a2-80a8-ce5d-6356" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="a9e7-9212-9290-4239" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Soultearer Portent" id="a5ad-0d8e-12f1-73ca" hidden="false" typeId="10e3-235b-fd89-87a6" typeName="Abillities">
              <characteristics>
                <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">If this prayer is heard, select one friendly &lt;Chaos&gt; Infantry, Daemon &lt;Alliance&gt; or &lt;Chaos&gt; CHARACTER unit within 6&quot; of this PRIEST. Each time a model in that unit makes a melee attack, add 1 to that attack’s wound roll.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Benediction of Darkness" id="cdf2-9eeb-2c26-f718" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="2014-96e5-dc04-f2d4" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Benediction of Darkness" id="d831-8124-77a7-e9a5" hidden="false" typeId="10e3-235b-fd89-87a6" typeName="Abillities">
              <characteristics>
                <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">If this prayer is heard, then while a friendly &lt;Chaos&gt; Infantry, &lt;Chaos&gt; CHARACTER or Daemon &lt;Alliance&gt; unit is wholly within 6&quot; of this PRIEST, each time a ranged attack is made against that unit, it is treated as having the benefits of Light Cover or +1 to Cover save if already in cover against that attack.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Hallowing of Darkness" id="61d6-6804-a671-9556" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="11ef-6035-e191-ee8d" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Hallowing of Darkness" id="bfe4-0d5c-34a0-e542" hidden="false" typeId="10e3-235b-fd89-87a6" typeName="Abillities">
              <characteristics>
                <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">If this Prayer is heard, while friendly &lt;Chaos&gt; Beastmen unit is Wholly within 12” of this PRIEST, That unit each time this unit makes a Charge Action. They may re-roll Any or all dice. In addition this unit gains a 4+ Feel no pain when Charging.</characteristic>
