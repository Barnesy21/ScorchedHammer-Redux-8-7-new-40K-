    <selectionEntry name="Path Of the Dark Gods" id="b57b-35df-cdc2-76e4" hidden="false" import="true" type="upgrade">
      <profiles>
        <profile name="Path Of the Dark Gods" id="1e57-889c-cfa6-c563" hidden="false" typeId="10e3-235b-fd89-87a6" typeName="Abillities">
          <characteristics>
            <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">Gain Abilities for your army based on the number of Units in your army are devoted to Specific Gods or who Walk the Black Path.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <selectionEntries>
        <selectionEntry name="Marks Of Khorne" id="9697-5ea7-a4fd-e5ea" hidden="true" import="true" type="upgrade">
