        <selectionEntry name="Gaze of Fate" id="01e1-5d2a-4c5f-4a1e" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="fa85-bb15-af64-6c24" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Gaze of Fate" id="40d4-c203-e733-4de2" hidden="false" typeId="f7ae-1618-90a8-558c" typeName="Psychic Power (Augment/HEX)">
              <characteristics>
                <characteristic name="Warp Charge" typeId="073a-3360-beab-6247">7</characteristic>
                <characteristic name="Range" typeId="59ce-10fb-8689-2d17">12&quot;</characteristic>
                <characteristic name="Details" typeId="f78e-01c6-7e67-f2db">Anytime if this model has a Cast available, may attempt to manifest this power, Select one enemy unit within 12&quot; that unit when rolling to determining hit, wound, damage, Leadership test, determine shots, or even a command Re-roll the player who cast this power may choose to have the player roll 2 dice and take the least favorable result, or the result specified by the Player who cast the spell. this can only be done once for each phase until the spell ends the next time the phase in which this power was casted.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Treason of Tzeentch" id="aeed-2ba3-1f1e-2be3" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="9073-c359-a9e5-a110" field="selections" includeChildSelections="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <profiles>
            <profile name="Treason of Tzeentch" id="f22f-7e95-efd4-0980" hidden="false" typeId="f7ae-1618-90a8-558c" typeName="Psychic Power (Augment/HEX)">
              <characteristics>
                <characteristic name="Warp Charge" typeId="073a-3360-beab-6247">8</characteristic>
                <characteristic name="Range" typeId="59ce-10fb-8689-2d17">18&quot;</characteristic>
                <characteristic name="Details" typeId="f78e-01c6-7e67-f2db">If manifested, select an enemy CHARACTER that is within 18&quot; of the psyker and visible to him (excluding the opponent’s Warlord) and roll 2D6. If the result is greater than the character’s Leadership characteristic, until the end of the following Fight phase treat that character as if it were a friendly model from your army in your Shooting, Charge and Fight phases.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
