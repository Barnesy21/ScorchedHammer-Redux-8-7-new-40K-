              </constraints>
              <profiles>
                <profile name="Profane Symbiosis" typeId="10e3-235b-fd89-87a6" typeName="Abillities" hidden="false" id="f85f-6429-3832-63f1">
                  <characteristics>
                    <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">Each time a model with this bond uses a Daemonic Surge:


If you choose to inflict one mortal wound, you can re-roll the D3 when determining what Daemonic Surge result applies to this model until the start of your next Command phase.


If you choose to inflict D3 mortal wounds, select two results from the Daemonic Surge table to apply to this model until the start of your next Command phase.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="House Korvax" hidden="false" id="e9a7-b719-aec3-d721">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="24b6-0c2b-4f5b-1153" includeChildSelections="false"/>
              </constraints>
              <profiles>
                <profile name="Forged in Terror" typeId="10e3-235b-fd89-87a6" typeName="Abillities" hidden="false" id="2d4d-c479-1409-8855">
                  <characteristics>
                    <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">Once per battle, at the start of any battle round, you can select one Harbinger ability from those corresponding to the current battle round, or any previous battle round. That ability becomes active for every model with this bond in your army, even if every unit in your army does not have the CHAOS KNIGHTS keyword.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="House Vextrix" hidden="false" id="a8ed-176e-4d78-6d85">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="5af9-7e36-af57-4d98" includeChildSelections="false"/>
              </constraints>
              <profiles>
                <profile name="Titankin" typeId="10e3-235b-fd89-87a6" typeName="Abillities" hidden="false" id="b76f-b31b-4149-97b0">
                  <characteristics>
                    <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">Each time a model with this bond is selected to shoot, you can re-roll one hit roll and one wound roll when resolving that model&apos;s attacks.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Infernal Dreadblades" hidden="false" id="0964-9aff-6862-722d">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="b776-4873-bac1-ec34" includeChildSelections="false"/>
              </constraints>
              <profiles>
                <profile name="Unnatural Fortitude" typeId="10e3-235b-fd89-87a6" typeName="Abillities" hidden="false" id="378a-1994-51a5-16f0">
                  <characteristics>
                    <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">When this unit is selected as the target of an attack, until the end of the phase, select one of the following:
Models in this unit have a +1 to their invulnerable save.
Models in this unit have the Feel No Pain 5+ ability.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Infernal Households" hidden="false" id="8b21-88f0-fc8e-cd50">
              <constraints>
                <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="2e6f-070b-bc51-4278" includeChildSelections="false"/>
              </constraints>
              <profiles>
                <profile name="Diabolic Power" typeId="10e3-235b-fd89-87a6" typeName="Abillities" hidden="false" id="d5f9-3432-1d3f-efaa">
                  <characteristics>
                    <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">When this unit is selected to shoot or fight, select either the [LETHAL HITS] or [SUSTAINED HITS 1] ability. Until the end of the phase, weapons equipped by models in this unit have the selected ability.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
          <constraints>
            <constraint type="min" value="1" field="selections" scope="parent" shared="true" id="54a5-c7ca-bcb9-f1ec-min" includeChildSelections="false"/>
            <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="54a5-c7ca-bcb9-f1ec-max" includeChildSelections="false"/>
          </constraints>
        </selectionEntry>
      </selectionEntries>
      <constraints>
        <constraint type="max" value="3" field="selections" scope="self" shared="true" id="a5d1-ff68-0e4e-98b5" includeChildSelections="true"/>
        <constraint type="max" value="1" field="selections" scope="parent" shared="true" id="422b-778d-8f08-751a" includeChildSelections="false"/>
      </constraints>
    </selectionEntry>
  </sharedSelectionEntries>
