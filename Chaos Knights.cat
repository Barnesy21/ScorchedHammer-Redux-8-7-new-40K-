    <profile name="Ion Shield (Knight)" typeId="10e3-235b-fd89-87a6" typeName="Abillities" hidden="false" id="90ae-e29d-8dc2-7fc5">
      <characteristics>
        <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">At the start of the opponents shooting phase, select the facing of the Ion Shield. The Ion Shield confers a 4+ Invunerable save against that facing until the start of your opponents next shooting phase.</characteristic>
      </characteristics>
    </profile>
    <profile name="Ion Shield (War Dog)" typeId="10e3-235b-fd89-87a6" typeName="Abillities" hidden="false" id="dd69-301f-4216-ea7f">
      <characteristics>
        <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">Models in this unit have a 5+ invulnerable save against ranged attacks.</characteristic>
      </characteristics>
    </profile>
