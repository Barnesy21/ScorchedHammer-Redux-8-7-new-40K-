        <characteristic name="Effect" typeId="13ab-c2de-f6b9-b1f6">Add 3&quot; to this model&apos;s Move characteristic.</characteristic>
      </characteristics>
    </profile>
    <profile name="Daemonic Fortitude" typeId="9155-7f33-0a84-ebe2" typeName="Daemonic Surge" hidden="false" id="f7cb-fc9b-1b82-a82b">
      <characteristics>
        <characteristic name="D3" typeId="3aed-89e5-58e2-ec0d">2</characteristic>
        <characteristic name="Name" typeId="d638-fc21-4153-9c77">Daemonic Fortitude</characteristic>
        <characteristic name="Effect" typeId="13ab-c2de-f6b9-b1f6">Each time an attack is made against this model, an unmodified wound roll of 1-3 for that attack fails, irrespective of any abilities that the weapon or the model making the attack may have.</characteristic>
      </characteristics>
    </profile>
    <profile name="Daemonic Power" typeId="9155-7f33-0a84-ebe2" typeName="Daemonic Surge" hidden="false" id="e845-64a2-5b18-b102">
      <characteristics>
        <characteristic name="D3" typeId="3aed-89e5-58e2-ec0d">3</characteristic>
        <characteristic name="Name" typeId="d638-fc21-4153-9c77">Daemonic Power</characteristic>
        <characteristic name="Effect" typeId="13ab-c2de-f6b9-b1f6">Select one weapon this model is equipped with. Each time an attack is made with that weapon, add 1 to thsat attack&apos;s wound roll.</characteristic>
      </characteristics>
    </profile>
