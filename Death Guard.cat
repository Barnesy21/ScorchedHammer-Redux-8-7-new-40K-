      <characteristics>
        <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">Enemy units that are within 6&quot; of any units with an Icon of Despair must subtract 1 from their Leadership.</characteristic>
      </characteristics>
    </profile>
    <profile name="Disgustingly Resilient" typeId="10e3-235b-fd89-87a6" typeName="Abillities" hidden="false" id="69b0-824a-e032-be02">
      <characteristics>
        <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">Each time a model with the rule takes damage Subtract 1 from the Damage to a min of a 1</characteristic>
      </characteristics>
    </profile>
    <profile name="Unrelenting Hord" typeId="10e3-235b-fd89-87a6" typeName="Abillities" hidden="false" id="17a9-4818-a616-32ed">
      <characteristics>
        <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">Models with this rule have a 5+ Feel no pain</characteristic>
      </characteristics>
    </profile>
    <profile name="Diseased Horde" typeId="10e3-235b-fd89-87a6" typeName="Abillities" hidden="false" id="20fd-5b4a-e1cf-fd5b">
      <characteristics>
        <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">You can add 1 to all hit rolls for this unit in the Fight phase if it contains more than 10 models.</characteristic>
