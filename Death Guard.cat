            <characteristic name="Abilities" typeId="90e1-1023-d27e-1bb2">Plague Weapon, Bonus Attacks D6</characteristic>
          </characteristics>
        </profile>
        <profile name="Silence - Reaping Scythe" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapons" hidden="false" id="0e27-a6a8-cc62-d6f8">
          <characteristics>
            <characteristic name="Range" typeId="4c40-c12d-8d74-1fe7">Melee</characteristic>
            <characteristic name="Type" typeId="b392-8288-2208-6ab2">Melee</characteristic>
            <characteristic name="S" typeId="b6e6-61d9-0a48-2696">User</characteristic>
            <characteristic name="AP" typeId="15b5-fbf0-b823-d985">-2</characteristic>
            <characteristic name="D" typeId="805f-6ece-e727-1ac1">1</characteristic>
            <characteristic name="Abilities" typeId="90e1-1023-d27e-1bb2">Plague Weapon, Extra Attacks +3</characteristic>
          </characteristics>
        </profile>
        <profile name="Silence - Eviscerating blow" typeId="d5f97c0b-9fc9-478d-aa34-a7c414d3ea48" typeName="Weapons" hidden="false" id="7ee5-52ed-bd20-aac8">
          <characteristics>
            <characteristic name="Range" typeId="4c40-c12d-8d74-1fe7">Melee</characteristic>
