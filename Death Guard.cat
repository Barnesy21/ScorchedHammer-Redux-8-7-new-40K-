              <profiles>
                <profile name="Daemonic Icon" typeId="10e3-235b-fd89-87a6" typeName="Abillities" hidden="false" id="c537-17c7-eb44-1088">
                  <characteristics>
                    <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">If you roll a 1 when taking a Morale test for a unit with any Daemonic Icons, reality blinks and the Daemonic horde is bolstered. No models flee and D6 slain Plaguebearers are instead added to the unit.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
