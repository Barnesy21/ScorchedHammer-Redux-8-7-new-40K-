          <characteristics>
            <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">DEATH GUARD CHARACTERS (excluding Mortarion) within 3&quot; of any friendly Deathshroud Terminator units add 1 to their Attacks characteristic.</characteristic>
          </characteristics>
        </profile>
        <profile name="Silent Bodyguard" typeId="10e3-235b-fd89-87a6" typeName="Abillities" hidden="false" id="e7e6-8a9e-7477-4d75">
          <characteristics>
            <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">Roll a dice each time a friendly DEATH GUARD CHARACTER is hit by a ranged or melee weapon attack whilst he is within 3&quot; of this unit. On a 2+ one of the Deathshroud intercepts that hit - the character is not hit by that attack but this unit is instead.</characteristic>
          </characteristics>
        </profile>
      </profiles>
