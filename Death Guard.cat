                <characteristic name="Range" typeId="59ce-10fb-8689-2d17">18&quot;</characteristic>
                <characteristic name="Details" typeId="f78e-01c6-7e67-f2db">Within range and Visible enemy Unit. roll a D3. Consult the table to discover what characteristic penalty all models in that unit suffer until the start of your next Psychic phase (this cannot reduce a characteristic to less than 1).</characteristic>
              </characteristics>
            </profile>
