              <profiles>
                <profile name="Instrument of Chaos" typeId="10e3-235b-fd89-87a6" typeName="Abillities" hidden="false" id="6b27-2ffd-5be9-210a">
                  <characteristics>
                    <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">If this unit has an Instrument of Chaos, then when an Advance or charge roll is made for this unit, add 1 to the roll.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry type="upgrade" import="true" name="Plague Banner" hidden="false" id="c4d6-914c-8f94-b2a9">
