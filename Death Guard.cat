                <cost name="CP" typeId="3e73-ebb4-4a79-ba46" value="0"/>
              </costs>
              <profiles>
                <profile name="Plague Banner" typeId="10e3-235b-fd89-87a6" typeName="Abillities" hidden="false" id="ff66-5d3e-b315-4019">
                  <characteristics>
                    <characteristic name="Description" typeId="a1eb-0258-504f-a2f2">The power of the banner can be used once per battle, just before the bearer&apos;s unit fights. When used, increase the Damage characteristic of all plagueswords carried by the bearer&apos;s unit to 2 until the end of the phase.</characteristic>
                  </characteristics>
