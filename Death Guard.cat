  <sharedRules>
    <rule name="Plague Weapon" id="0de9-17e5-e2a2-667f" hidden="false">
      <description>If the Target unit is a infantry, Calvary or Monster. This weapon has the Lethal Hits, and may re-roll wound rolls of a 1.</description>
    </rule>
    <rule name="Reverberating Summons" id="23c9-77cf-0f45-6bb9" hidden="false">
      <description>Each time a model is destroyed by this weapon, you can select one friendly PLAGUEBEARERS unit within 12&quot; of the bearer and return 1 destroyed Plaguebearer model to that unit.</description>
    </rule>
  </sharedRules>
